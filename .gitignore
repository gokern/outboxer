# Hidden entries at the repo root (dotfiles/dotdirs): ignore by default,
# then allow the dotfiles we actually want to track.
/.[!.]*
/.?*
!/.gitignore
!/.golangci.yaml
!/.github/

# Go build / test artifacts
*.exe
*.test
*.out
*.prof
coverage.*
/bin/
/dist/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Assistant working files that live in this tree but are not part of the module
CLAUDE.md
docs/superpowers/
**/.claude/
**/.superpowers/

# Local mise overrides: user-specific tool/task tweaks, never part of the module
/mise.local.toml
